/// Medication ordering & delivery (module step 1): the medication catalog and
/// the documents / handling each kind of medication needs. The catalog is
/// imported from a standardized list (e.g. Senegal's Liste Nationale des
/// Médicaments et Produits Essentiels — LNMPE) — never hard-coded. Nomad adds
/// the flags the source lists don't carry (regulatory class, cold chain…).

/// Senegal's classes of "substances vénéneuses" (Loi n°2023-06): Liste I
/// (toxic), Liste II (dangerous) and narcotics (stupéfiants). Anything listed
/// needs a prescription.
enum MedicationRegulatoryClass {
  NOT_LISTED
  LIST_II
  LIST_I
  NARCOTIC
}

/// One orderable product: a generic (DCI) at a strength and form, with its
/// usual brand. `code` is the stable key re-imports match on.
model Medication {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String                    @unique
  /// Generic name (DCI / INN), e.g. "Paracétamol".
  dci                  String
  brandName            String?                   @map("brand_name")
  /// As written in the source, e.g. "500mg", "100UI", "125mg/5ml".
  strength             String?
  /// e.g. comprimé, gélule, sirop, injectable.
  form                 String
  /// Pack size, e.g. "boîte de 16" (the LNMPE doesn't give one).
  presentation         String?
  therapeuticClass     String?                   @map("therapeutic_class")
  regulatoryClass      MedicationRegulatoryClass @default(NOT_LISTED) @map("regulatory_class")
  isPsychotropic       Boolean                   @default(false) @map("is_psychotropic")
  /// Must be kept cold (2–8 °C) in transit.
  isColdChain          Boolean                   @default(false) @map("is_cold_chain")
  /// Always true for listed classes; can also be set for an unlisted item.
  prescriptionRequired Boolean                   @default(false) @map("prescription_required")
  /// Where the row came from, e.g. "LNMPE 2025".
  source               String?
  /// Marketing authorisation number (Numéro AMM) on the regulator's list.
  ammNumber            String?                   @map("amm_number")
  /// Official public price per pack in FCFA, from the regulator's list.
  /// Empty when the list gives none (or gives 0) — see priceStatus.
  officialPriceXof     Int?                      @map("official_price_xof")
  /// The list's own word on the price, e.g. OFFICIAL_PRICE_AVAILABLE,
  /// MISSING_VERIFY, ZERO_VERIFY.
  priceStatus          String?                   @map("price_status")
  manufacturer         String?
  /// Route of administration, e.g. orale, injectable, cutanée.
  route                String?
  sourceUrl            String?                   @map("source_url")
  /// When the source was consulted.
  sourceCheckedOn      DateTime?                 @map("source_checked_on") @db.Date
  /// Nomad's own notes on the item.
  notes                String?
  /// Link to the product information sheet (RCP / SmPC).
  rcpUrl               String?                   @map("rcp_url")
  /// Link to a photo of the pack.
  photoUrl             String?                   @map("photo_url")
  /// Example rows for testing — flags are suggestions, not checked by a
  /// pharmacist. Removable in one go.
  isSample             Boolean                   @default(false) @map("is_sample")
  isActive             Boolean                   @default(true) @map("is_active")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  createdBy            String?                   @map("created_by") @db.Uuid
  updatedBy            String?                   @map("updated_by") @db.Uuid

  orderLines        MedicationOrderLine[]
  priceObservations MedicationPriceObservation[]

  @@index([dci])
  @@index([brandName])
  @@map("medication")
}

/// What triggers a requirement: a regulatory class, or a flag on the item.
enum MedicationRequirementTrigger {
  PRESCRIPTION_REQUIRED
  LIST_II
  LIST_I
  NARCOTIC
  PSYCHOTROPIC
  COLD_CHAIN
}

enum MedicationRequirementKind {
  /// A photo/scan the member uploads (e.g. the prescription).
  UPLOAD
  /// A paper original the courier must collect before the pharmacy (e.g. a
  /// narcotics prescription on a carnet à souches sheet).
  ORIGINAL_TO_COLLECT
  /// An identity document (patient's, or the bearer's).
  ID_DOCUMENT
  /// Handling instructions for the pharmacy and courier (e.g. keep cold).
  HANDLING
}

/// The documents and handling an order needs, by what's in it — editable in
/// Admin > Value lists > Medication delivery. An order collects every active
/// requirement triggered by any of its items.
model MedicationRequirementRef {
  id            String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String                       @unique
  nameEn        String                       @map("name_en")
  nameFr        String?                      @map("name_fr")
  /// What the member / courier / pharmacy is asked to do.
  descriptionEn String?                      @map("description_en")
  descriptionFr String?                      @map("description_fr")
  appliesTo     MedicationRequirementTrigger @map("applies_to")
  kind          MedicationRequirementKind
  sortOrder     Int                          @default(0) @map("sort_order")
  isActive      Boolean                      @default(true) @map("is_active")
  createdAt     DateTime                     @default(now()) @map("created_at")
  updatedAt     DateTime                     @updatedAt @map("updated_at")

  @@map("medication_requirement_ref")
}

/// Where a medication order is in its journey. Step 2 creates orders as
/// REQUESTED; the later steps move them along.
enum MedicationOrderStatus {
  REQUESTED
  SEARCHING_PHARMACIES
  PHARMACY_CONFIRMED
  PRICE_CONFIRMED
  AWAITING_APPROVAL
  AWAITING_PAYMENT
  PAID
  PREPARING
  /// The pharmacy confirmed it received Nomad's payment: book the courier.
  READY_FOR_PICKUP
  COURIER_REQUESTED
  ORIGINAL_COLLECTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  /// The courier couldn't hand it over; a re-delivery fee is due (or waived).
  DELIVERY_FAILED
  CANCELLED
  UNAVAILABLE
}

/// A medication order: one per case (the case's request type is Medication).
/// Delivery details and the flags of what's in it are kept on the order, so
/// later catalog edits don't change it.
model MedicationOrder {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId             String                @unique @map("case_id") @db.Uuid
  case               CareCase              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// Who the medication is for (also the case's patient).
  patientId          String                @map("patient_id") @db.Uuid
  patient            Member                @relation("MedicationOrderPatient", fields: [patientId], references: [id])
  status             MedicationOrderStatus @default(REQUESTED)
  deliveryAddress    String                @map("delivery_address")
  deliveryLatitude   Float?                @map("delivery_latitude")
  deliveryLongitude  Float?                @map("delivery_longitude")
  deliveryNotes      String?               @map("delivery_notes")
  memberNote         String?               @map("member_note")
  /// Rolled up from the items when the order was placed.
  needsPrescription  Boolean               @default(false) @map("needs_prescription")
  hasNarcotic        Boolean               @default(false) @map("has_narcotic")
  hasPsychotropic    Boolean               @default(false) @map("has_psychotropic")
  hasColdChain       Boolean               @default(false) @map("has_cold_chain")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  lines     MedicationOrderLine[]
  quotes    PharmacyQuote[]
  /// The quote Nomad (or staff) chose — set from step 3.
  chosenQuoteId String? @unique @map("chosen_quote_id") @db.Uuid
  chosenQuote   PharmacyQuote? @relation("ChosenQuote", fields: [chosenQuoteId], references: [id])
  /// The member's price (step 4), fixed when sent: medicines from the
  /// chosen quote + delivery + Nomad fee. All FCFA.
  medicinesXof    Int?      @map("medicines_xof")
  deliveryXof     Int?      @map("delivery_xof")
  feeXof          Int?      @map("fee_xof")
  totalXof        Int?      @map("total_xof")
  /// Why staff changed the delivery or fee from the automatic price.
  priceNote       String?   @map("price_note")
  priceSentAt     DateTime? @map("price_sent_at")
  priceValidUntil DateTime? @map("price_valid_until")
  approvedAt      DateTime? @map("approved_at")
  /// Approved by phone and recorded by staff (else by the member in the app).
  approvedByStaffId String? @map("approved_by_staff_id") @db.Uuid
  declinedAt      DateTime? @map("declined_at")
  declineReason   String?   @map("decline_reason")
  /// An exact-amount payment link staff made for this order (overrides the
  /// standard links from Admin).
  paymentLinkUrl  String?   @map("payment_link_url")
  payments        MedicationOrderPayment[]
  /// Delivery (step 5). Deliver-by deadline, set when the member's payment
  /// is confirmed, from the timeframe they chose.
  promisedBy      DateTime? @map("promised_by")
  /// When the pharmacy confirmed Nomad's payment (the order is then ready).
  readyAt         DateTime? @map("ready_at")
  /// Staff nudges already sent (each once).
  alertBookCourierAt  DateTime? @map("alert_book_courier_at")
  alertPharmacyAt     DateTime? @map("alert_pharmacy_at")
  alertLateAt         DateTime? @map("alert_late_at")
  deliveries      MedicationDelivery[]
  charges         MedicationOrderCharge[]
  documents MedicationOrderDocument[]

  @@index([status])
  @@map("medication_order")
}

/// One item: a catalog medication (its details copied at order time), or a
/// free-text item "not in the list" for the pharmacist to identify.
model MedicationOrderLine {
  id                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId              String                     @map("order_id") @db.Uuid
  order                MedicationOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicationId         String?                    @map("medication_id") @db.Uuid
  medication           Medication?                @relation(fields: [medicationId], references: [id])
  /// Set for an item not in the catalog — what the member typed.
  freeText             String?                    @map("free_text")
  dci                  String?
  brandName            String?                    @map("brand_name")
  strength             String?
  form                 String?
  regulatoryClass      MedicationRegulatoryClass? @map("regulatory_class")
  isPsychotropic       Boolean                    @default(false) @map("is_psychotropic")
  isColdChain          Boolean                    @default(false) @map("is_cold_chain")
  prescriptionRequired Boolean                    @default(false) @map("prescription_required")
  /// Boxes / bottles / units, as the member asked.
  quantity             Int
  quoteLines           PharmacyQuoteLine[]
  sortOrder            Int                        @default(0) @map("sort_order")

  @@index([orderId])
  @@map("medication_order_line")
}

/// A file the member (or staff) provided for one of the order's
/// requirements — e.g. the prescription photo. `requirementCode` is copied so
/// renaming a rule later doesn't change past orders.
model MedicationOrderDocument {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String          @map("order_id") @db.Uuid
  order           MedicationOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requirementCode String          @map("requirement_code")
  fileId          String          @unique @map("file_id") @db.Uuid
  file            StoredFile      @relation(fields: [fileId], references: [id])
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([orderId])
  @@map("medication_order_document")
}

enum PharmacyQuoteStatus {
  /// Picked for this order; not sent yet.
  PREPARED
  /// Sent (a private link is live).
  SENT
  ANSWERED
  /// The pharmacy said it can't fill the order.
  DECLINED
  /// The link ran out without an answer.
  EXPIRED
  CANCELLED
}

enum QuoteAvailability {
  AVAILABLE
  PARTIAL
  UNAVAILABLE
}

/// One pharmacy asked about one order (medication delivery, step 3). The
/// pharmacy answers on a private link (/q/<token>, no login); only a hash of
/// the token is stored, and sending again makes a new link.
model PharmacyQuote {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String              @map("order_id") @db.Uuid
  order              MedicationOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  providerId         String              @map("provider_id") @db.Uuid
  provider           Provider            @relation(fields: [providerId], references: [id])
  status             PharmacyQuoteStatus @default(PREPARED)
  /// Where it ranked and why, when it was picked.
  rank               Int
  distanceKm         Float?              @map("distance_km")
  openWhenAsked      Boolean             @map("open_when_asked")
  tokenHash          String?             @unique @map("token_hash")
  sentAt             DateTime?           @map("sent_at")
  sentById           String?             @map("sent_by_id") @db.Uuid
  sentBy             User?               @relation("QuoteSentBy", fields: [sentById], references: [id])
  expiresAt          DateTime?           @map("expires_at")
  answeredAt         DateTime?           @map("answered_at")
  preparationMinutes Int?                @map("preparation_minutes")
  /// Confirmations the order needed (null when not asked).
  canDispenseNarcotic Boolean?           @map("can_dispense_narcotic")
  canPackColdChain   Boolean?            @map("can_pack_cold_chain")
  pharmacistName     String?             @map("pharmacist_name")
  note               String?
  /// Entered by staff from a phone call rather than on the link.
  enteredByStaff     Boolean             @default(false) @map("entered_by_staff")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  lines        PharmacyQuoteLine[]
  chosenFor    MedicationOrder?    @relation("ChosenQuote")

  @@unique([orderId, providerId])
  @@index([providerId, sentAt])
  @@map("pharmacy_quote")
}

/// The pharmacy's answer for one item of the order.
model PharmacyQuoteLine {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId          String              @map("quote_id") @db.Uuid
  quote            PharmacyQuote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  orderLineId      String              @map("order_line_id") @db.Uuid
  orderLine        MedicationOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  availability     QuoteAvailability
  /// Packs they can supply (for PARTIAL: fewer than asked).
  quantityOffered  Int?                @map("quantity_offered")
  /// Price of one pack, in FCFA.
  packPriceXof     Int?                @map("pack_price_xof")
  /// e.g. "Boîte de 16" — prices are only comparable per pack size.
  packDescription  String?             @map("pack_description")
  unitsPerPack     Int?                @map("units_per_pack")
  /// A pharmacist's proposal (e.g. another brand of the same generic) —
  /// needs the member's approval.
  substitution     String?

  priceObservation MedicationPriceObservation?

  @@unique([quoteId, orderLineId])
  @@map("pharmacy_quote_line")
}

enum PriceTimeBand {
  /// 07:00–18:00 Dakar
  DAY
  /// 18:00–22:00
  EVENING
  /// 22:00–07:00
  NIGHT
}

/// Medication price history for analysis (business intelligence): one row
/// per priced quote line, written when the pharmacy answers and never
/// edited — a correction is a new row. Holds no personal data about the
/// member. Whether the quote was chosen is read from the quote.
model MedicationPriceObservation {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  observedAt        DateTime          @map("observed_at")
  medicationId      String?           @map("medication_id") @db.Uuid
  medication        Medication?       @relation(fields: [medicationId], references: [id])
  /// The item as named at the time (catalog label, or free text).
  itemLabel         String            @map("item_label")
  packDescription   String?           @map("pack_description")
  unitsPerPack      Int?              @map("units_per_pack")
  pricePerPackXof   Int               @map("price_per_pack_xof")
  pricePerUnitXof   Float?            @map("price_per_unit_xof")
  providerId        String            @map("provider_id") @db.Uuid
  provider          Provider          @relation(fields: [providerId], references: [id])
  city              String?
  latitude          Float?
  longitude         Float?
  /// 1 = Monday … 7 = Sunday, Dakar time.
  dayOfWeek         Int               @map("day_of_week")
  timeBand          PriceTimeBand     @map("time_band")
  pharmacyOpen24_7  Boolean           @map("pharmacy_open_24_7")
  availability      QuoteAvailability
  isSubstitution    Boolean           @map("is_substitution")
  /// Minutes from sending the request to the answer.
  responseMinutes   Int?              @map("response_minutes")
  source            String            @default("QUOTE")
  /// Far from the usual price for this item — for staff to check.
  isOutlier         Boolean           @default(false) @map("is_outlier")
  quoteLineId       String?           @unique @map("quote_line_id") @db.Uuid
  quoteLine         PharmacyQuoteLine? @relation(fields: [quoteLineId], references: [id], onDelete: SetNull)
  quoteId           String?           @map("quote_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at")

  @@index([medicationId, observedAt])
  @@index([providerId, observedAt])
  @@map("medication_price_observation")
}

/// The "When do you need it?" choices on the member's medication order —
/// fixed rows (code = the case urgency each one sets, which drives its
/// colour, response time and pharmacy choice); admins edit the wording,
/// order and whether it's offered, in Admin > Value lists > Medication
/// delivery > Delivery timeframes.
model MedicationTimeframeRef {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  labelEn   String   @map("label_en")
  labelFr   String?  @map("label_fr")
  /// Shown under the choice, e.g. "Not for life-threatening emergencies…".
  helpEn    String?  @map("help_en")
  helpFr    String?  @map("help_fr")
  isOffered Boolean  @default(true) @map("is_offered")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("medication_timeframe_ref")
}

/// Medication delivery settings — fixed rows looked up by code, numbers
/// only, edited in Admin > Value lists > Medication delivery (admins change
/// the value, not the rows).
model MedicationDeliverySetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  labelEn   String   @map("label_en")
  labelFr   String?  @map("label_fr")
  value     Int
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("medication_delivery_setting")
}

enum PaymentDirection {
  /// The member pays Nomad the total.
  FROM_MEMBER
  /// Nomad pays the pharmacy for the medicines.
  TO_PHARMACY
}

enum PaymentMethod {
  WAVE
  ORANGE_MONEY
  CASH
  OTHER
}

enum PaymentStatus {
  /// The member says they've paid; staff haven't checked yet.
  REPORTED
  CONFIRMED
  /// Checked and not found / wrong amount.
  REJECTED
}

/// Money in and out for a medication order (step 4): the member's payment
/// to Nomad, and Nomad's payment to the pharmacy. Confirmed by staff
/// against the transaction reference for now; the Wave / Orange Money APIs
/// will confirm automatically later (`externalId` = their session id).
model MedicationOrderPayment {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String           @map("order_id") @db.Uuid
  order            MedicationOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  direction        PaymentDirection
  method           PaymentMethod
  amountXof        Int              @map("amount_xof")
  status           PaymentStatus
  /// Transaction id from Wave / Orange Money, as given.
  reference        String?
  externalId       String?          @map("external_id")
  /// For payments to a pharmacy: who, and which approved payment details.
  providerId       String?          @map("provider_id") @db.Uuid
  provider         Provider?        @relation(fields: [providerId], references: [id])
  bankingPaymentId String?          @map("banking_payment_id") @db.Uuid
  bankingPayment   BankingPayment?  @relation(fields: [bankingPaymentId], references: [id])
  reportedByMember Boolean          @default(false) @map("reported_by_member")
  recordedById     String?          @map("recorded_by_id") @db.Uuid
  recordedBy       User?            @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  confirmedAt      DateTime?        @map("confirmed_at")
  note             String?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("medication_order_payment")
}

/// Nomad's standard payment links for members (e.g. the Wave Business and
/// Orange Money merchant links) — Admin > Value lists > Medication delivery.
/// Used when an order has no exact-amount link of its own.
model PaymentLinkRef {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String        @unique
  method    PaymentMethod
  labelEn   String        @map("label_en")
  labelFr   String?       @map("label_fr")
  url       String
  sortOrder Int           @default(0) @map("sort_order")
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("payment_link_ref")
}

/// A courier trip, booked by staff in Yango (or another service) and
/// recorded here. A controlled medicine is one trip with three stops:
/// the member (paper prescription) → the pharmacy → back to the member.
/// A failed trip stays on record; the next attempt is a new row.
model MedicationDelivery {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String          @map("order_id") @db.Uuid
  order          MedicationOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attempt        Int             @default(1)
  courierService String          @default("YANGO") @map("courier_service")
  trackingUrl    String?         @map("tracking_url")
  bookingRef     String?         @map("booking_ref")
  /// What Nomad paid the courier service, FCFA (for the delivery margin).
  costXof        Int?            @map("cost_xof")
  etaAt          DateTime?       @map("eta_at")
  courierName    String?         @map("courier_name")
  courierPhone   String?         @map("courier_phone")
  /// Three stops (collect the paper prescription first).
  collectOriginal Boolean        @default(false) @map("collect_original")
  bookedAt       DateTime        @default(now()) @map("booked_at")
  bookedById     String?         @map("booked_by_id") @db.Uuid
  originalCollectedAt DateTime?  @map("original_collected_at")
  pickedUpAt     DateTime?       @map("picked_up_at")
  deliveredAt    DateTime?       @map("delivered_at")
  /// MEMBER (tapped "I've received it") or STAFF (with a reason).
  deliveredConfirmedBy String?   @map("delivered_confirmed_by")
  deliveredNote  String?         @map("delivered_note")
  failedAt       DateTime?       @map("failed_at")
  failReason     String?         @map("fail_reason")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("medication_delivery")
}

enum OrderChargeStatus {
  DUE
  PAID
  WAIVED
}

/// An extra charge on an order — for now the re-delivery fee after a failed
/// delivery. Staff can waive it (with a reason).
model MedicationOrderCharge {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String            @map("order_id") @db.Uuid
  order        MedicationOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind         String            @default("REDELIVERY")
  amountXof    Int               @map("amount_xof")
  status       OrderChargeStatus @default(DUE)
  reason       String?
  waivedReason String?           @map("waived_reason")
  waivedById   String?           @map("waived_by_id") @db.Uuid
  waivedAt     DateTime?         @map("waived_at")
  /// The member's payment (method + transaction id), once reported/confirmed.
  paymentMethod    PaymentMethod? @map("payment_method")
  paymentReference String?        @map("payment_reference")
  reportedAt   DateTime?         @map("reported_at")
  paidAt       DateTime?         @map("paid_at")
  confirmedById String?          @map("confirmed_by_id") @db.Uuid
  createdById  String?           @map("created_by_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("medication_order_charge")
}

/// Automatic messages posted in the member's request chat at each step of
/// a medication order — fixed codes, wording editable in Admin > Value
/// lists > Medication delivery > Automatic messages. Placeholders such as
/// {reference}, {total}, {eta}, {fee} are filled in when sent.
model MemberMessageTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  labelEn   String   @map("label_en")
  bodyEn    String   @map("body_en")
  bodyFr    String?  @map("body_fr")
  /// Off: this step sends nothing.
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
