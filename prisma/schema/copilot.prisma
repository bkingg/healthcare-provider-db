/// The AI copilot (MVP step 1.4, "light"): buttons that draft a reply to a
/// member, summarise a case, or suggest a medication's flags. A person
/// always reviews: nothing is sent, saved or changed by the AI itself.
/// Personal details are replaced by placeholders before any text leaves
/// Nomad (src/lib/deidentify.ts); only text is sent, never files.

/// What each button asks the AI to do, editable in Admin > Value lists >
/// AI copilot: on/off and the instructions it's given. Fixed codes.
model CopilotTaskSetting {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// REPLY_DRAFT, CASE_SUMMARY or CATALOG_FLAGS.
  code         String   @unique
  labelEn      String   @map("label_en")
  labelFr      String?  @map("label_fr")
  enabled      Boolean  @default(true)
  instructions String
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("copilot_task")
}

/// Budget and prices (Admin > Value lists > AI copilot settings).
model CopilotSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  labelEn   String   @map("label_en")
  labelFr   String?  @map("label_fr")
  value     Int
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("copilot_setting")
}

enum CopilotOutcome {
  /// Shown to staff, nothing done with it yet.
  PENDING
  SENT_AS_IS
  SENT_EDITED
  SAVED_AS_NOTE
  APPLIED
  DISMISSED
  FAILED
  /// Not run: switched off or over budget.
  BLOCKED
}

/// One use of a copilot button: who, what for, what it cost and what staff
/// did with the answer. The text itself is not kept.
model CopilotUsage {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task         String
  userId       String         @map("user_id") @db.Uuid
  user         User           @relation(fields: [userId], references: [id])
  caseId       String?        @map("case_id") @db.Uuid
  case         CareCase?      @relation(fields: [caseId], references: [id], onDelete: SetNull)
  /// "mock" (test answers) or "openai".
  provider     String
  model        String
  inputTokens  Int            @default(0) @map("input_tokens")
  outputTokens Int            @default(0) @map("output_tokens")
  /// Millionths of a US dollar.
  costMicroUsd Int            @default(0) @map("cost_micro_usd")
  /// Token counts estimated (test answers), not reported by the provider.
  estimated    Boolean        @default(false)
  outcome      CopilotOutcome @default(PENDING)
  outcomeAt    DateTime?      @map("outcome_at")
  /// Fingerprint of a reply draft, to tell "sent as is" from "edited"
  /// without keeping the text.
  draftHash    String?        @map("draft_hash")
  error        String?
  createdAt    DateTime       @default(now()) @map("created_at")

  flagSuggestions CopilotFlagSuggestion[]

  @@index([createdAt])
  @@index([caseId])
  @@map("copilot_usage")
}

/// A suggested set of flags for one catalog item, waiting for someone who
/// edits the catalog to apply or dismiss it.
model CopilotFlagSuggestion {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  medicationId         String                    @map("medication_id") @db.Uuid
  medication           Medication                @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  usageId              String                    @map("usage_id") @db.Uuid
  usage                CopilotUsage              @relation(fields: [usageId], references: [id], onDelete: Cascade)
  regulatoryClass      MedicationRegulatoryClass @map("regulatory_class")
  prescriptionRequired Boolean                   @map("prescription_required")
  isColdChain          Boolean                   @map("is_cold_chain")
  isPsychotropic       Boolean                   @map("is_psychotropic")
  /// LOW, MEDIUM or HIGH.
  confidence           String
  reason               String
  /// PENDING, APPLIED or DISMISSED.
  status               String                    @default("PENDING")
  decidedById          String?                   @map("decided_by_id") @db.Uuid
  decidedAt            DateTime?                 @map("decided_at")
  createdAt            DateTime                  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([medicationId])
  @@map("copilot_flag_suggestion")
}
