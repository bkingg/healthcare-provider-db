model Credential {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId       String              @map("provider_id") @db.Uuid
  provider         Provider            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  credentialTypeId String              @map("credential_type_id") @db.Uuid
  credentialType   CredentialTypeRef   @relation(fields: [credentialTypeId], references: [id])
  statusId         String              @map("status_id") @db.Uuid
  status           CredentialStatusRef @relation(fields: [statusId], references: [id])
  documentUrl      String?             @map("document_url")
  issuedDate       DateTime?           @map("issued_date") @db.Date
  validationDate   DateTime?           @map("validation_date") @db.Date
  reviewedById     String?             @map("reviewed_by") @db.Uuid
  reviewedBy       User?               @relation("CredentialReviewedBy", fields: [reviewedById], references: [id])
  expirationDate   DateTime?           @map("expiration_date") @db.Date
  renewalDate      DateTime?           @map("renewal_date") @db.Date
  notes            String?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  createdBy        String?             @map("created_by") @db.Uuid
  updatedBy        String?             @map("updated_by") @db.Uuid

  @@index([providerId])
  @@index([expirationDate])
  @@map("credential")
}

model NetworkContract {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId          String         @map("provider_id") @db.Uuid
  provider            Provider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  networkId           String         @map("network_id") @db.Uuid
  network             NetworkRef     @relation(fields: [networkId], references: [id])
  status              ContractStatus @default(DRAFT)
  effectiveDate       DateTime       @map("effective_date") @db.Date
  endDate             DateTime?      @map("end_date") @db.Date
  terms               String?
  documentUrl         String?        @map("document_url")
  /// The network/payer's own identifier for this specific contract
  /// relationship — not Provider.externalId (that's the provider's legacy
  /// source-system id, unrelated to any one network). Lets the external
  /// company cross-reference this record against theirs; purely a free-text
  /// label from their system, never generated or validated here.
  externalReferenceId String?        @map("external_reference_id")
  comments            String?
  approvedById        String?        @map("approved_by") @db.Uuid
  approvedBy          User?          @relation("ContractApprovedBy", fields: [approvedById], references: [id])
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  createdBy           String?        @map("created_by") @db.Uuid
  updatedBy           String?        @map("updated_by") @db.Uuid

  @@index([providerId])
  @@index([status])
  @@map("network_contract")
}

/// Self-referential relation on Provider: `providerId` is the subject provider,
/// `relatedProviderId` is the other party (parent org, associated clinician,
/// service location, etc). Two named relations back to Provider are required
/// since Prisma can't infer direction on a self-relation automatically.
model Affiliation {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId        String             @map("provider_id") @db.Uuid
  provider          Provider           @relation("AffiliationSubject", fields: [providerId], references: [id], onDelete: Cascade)
  relatedProviderId String             @map("related_provider_id") @db.Uuid
  relatedProvider   Provider           @relation("AffiliationRelated", fields: [relatedProviderId], references: [id], onDelete: Cascade)
  affiliationTypeId String             @map("affiliation_type_id") @db.Uuid
  affiliationType   AffiliationTypeRef @relation(fields: [affiliationTypeId], references: [id])
  effectiveDate     DateTime?          @map("effective_date") @db.Date
  endDate           DateTime?          @map("end_date") @db.Date
  notes             String?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  createdBy         String?            @map("created_by") @db.Uuid
  updatedBy         String?            @map("updated_by") @db.Uuid

  @@index([providerId])
  @@index([relatedProviderId])
  @@map("affiliation")
}
