/// Nomad members: primary members and their dependents in one table. A
/// primary member has no primaryMemberId; a dependent points at its primary
/// and says how it's related. Households are one level deep — a dependent
/// can't have dependents of its own (enforced in src/data/members.ts).
/// Members come both through groups (an employer or insurer, with optional
/// plan/policy/coverage fields) and as individuals (no organization).
model Member {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Short human-facing ID, shown as MBR-000123 (see lib/memberNumber.ts).
  memberNumber      Int         @unique @default(autoincrement()) @map("member_number")
  firstName         String      @map("first_name")
  lastName          String      @map("last_name")
  dateOfBirth       DateTime?   @map("date_of_birth") @db.Date
  sex               MemberSex   @default(UNSPECIFIED)
  /// Stored lowercased. Unique across members because it's the member's
  /// sign-in identity (magic link by email, step 1.2); optional because
  /// children and members without email can't sign in themselves.
  email             String?     @unique
  phone             String?
  /// "fr" or "en" — the member app's language.
  preferredLanguage String      @default("fr") @map("preferred_language")
  countryId         String?     @map("country_id") @db.Uuid
  country           CountryRef? @relation(fields: [countryId], references: [id])
  city              String?

  primaryMemberId String?                @map("primary_member_id") @db.Uuid
  primaryMember   Member?                @relation("Household", fields: [primaryMemberId], references: [id], onDelete: Restrict)
  dependents      Member[]               @relation("Household")
  relationshipId  String?                @map("relationship_id") @db.Uuid
  relationship    MemberRelationshipRef? @relation(fields: [relationshipId], references: [id])

  organizationId String?          @map("organization_id") @db.Uuid
  organization   OrganizationRef? @relation(fields: [organizationId], references: [id])
  planName       String?          @map("plan_name")
  policyNumber   String?          @map("policy_number")
  coverageStart  DateTime?        @map("coverage_start") @db.Date
  coverageEnd    DateTime?        @map("coverage_end") @db.Date
  /// False for someone Nomad helps without cover ("Not covered"): every case
  /// for them is a special request (free or at a set cost). Left out of
  /// covered-member counts.
  isCovered      Boolean          @default(true) @map("is_covered")
  /// How the record was created: STAFF (by hand), IMPORT, or SELF (quick
  /// start in the member app). Empty for records from before this was kept.
  signupSource   String?          @map("signup_source")
  /// When the member accepted the privacy notice, and which version.
  consentAt      DateTime?        @map("consent_at")
  consentVersion String?          @map("consent_version")

  addresses      MemberAddress[]
  pushSubscriptions PushSubscription[]
  loginTokens    MemberLoginToken[]
  sessions       MemberSession[]
  casesRequested CareCase[]         @relation("CasesRequested")
  casesAbout     CareCase[]         @relation("CasesAbout")
  medicationOrdersFor MedicationOrder[] @relation("MedicationOrderPatient")
  uploadedFiles  StoredFile[]       @relation("FileUploadedByMember")
  caseEvents     CaseEvent[]        @relation("CaseEventsByMember")

  status    MemberStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  createdBy String?      @map("created_by") @db.Uuid
  updatedBy String?      @map("updated_by") @db.Uuid

  @@index([primaryMemberId])
  @@index([organizationId])
  @@index([lastName, firstName])
  @@map("member")
}

enum MemberSex {
  FEMALE
  MALE
  UNSPECIFIED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum OrganizationKind {
  EMPLOYER
  INSURER
  OTHER
}

/// Employers, insurers and other groups members come through — a managed
/// list (Admin > Value lists > Organizations) so group names stay
/// consistent for filtering and reporting.
model OrganizationRef {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String           @unique
  name      String
  kind      OrganizationKind @default(EMPLOYER)
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  members Member[]

  @@map("organization_ref")
}

/// How a dependent relates to its primary member (spouse, child, parent,
/// other) — editable in Admin > Value lists.
model MemberRelationshipRef {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  nameEn    String   @map("name_en")
  nameFr    String?  @map("name_fr")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members Member[]

  @@map("member_relationship_ref")
}

/// A member's saved addresses, reused when they order or ask for help.
/// Only the PRIMARY address is offered for now; the list leaves room for
/// "work" or a relative's home later. One of each kind per member.
model MemberAddress {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId    String    @map("member_id") @db.Uuid
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind        String    @default("PRIMARY")
  /// Neighbourhood, street or villa, building, floor.
  addressText String    @map("address_text")
  /// Landmark / directions for the courier.
  directions  String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  /// Staff user who last changed it; empty when the member did.
  updatedBy   String?   @map("updated_by") @db.Uuid

  @@unique([memberId, kind])
  @@map("member_address")
}
