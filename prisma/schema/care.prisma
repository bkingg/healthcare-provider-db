/// Member app (MVP step 1.2): member sign-in, help requests (cases), and the
/// admin-editable lists the member app shows (request categories, emergency
/// numbers). Kept apart from staff auth: a member session can never reach a
/// staff page, and staff sessions don't touch these tables.

/// One-time sign-in link sent by email (magic link). Only a SHA-256 hash of
/// the token is stored; the link expires after 15 minutes and works once.
model MemberLoginToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId  String    @map("member_id") @db.Uuid
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([memberId, createdAt])
  @@map("member_login_token")
}

/// A signed-in member's session. The cookie holds a random token; only its
/// hash is stored, so a database leak doesn't expose live sessions. Signing
/// out deletes the row.
model MemberSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId   String   @map("member_id") @db.Uuid
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([memberId])
  @@map("member_session")
}

enum CaseUrgency {
  /// Member said it's life-threatening — shown the emergency numbers first.
  EMERGENCY
  TODAY
  THIS_WEEK
  ROUTINE
}

enum CaseStatus {
  NEW
  IN_PROGRESS
  WAITING_MEMBER
  RESOLVED
  CLOSED
}

/// Operations dashboard colour: GREEN on track, YELLOW needs attention,
/// RED urgent. Set by rules (src/lib/caseRules.ts); ragReasons says why.
enum CaseRag {
  GREEN
  YELLOW
  RED
}

/// How the member got in touch. MEMBER_APP cases come from the app; the
/// others are opened by staff. (STAFF is an early value, no longer offered.)
enum CaseChannel {
  MEMBER_APP
  STAFF
  PHONE
  EMAIL
  WHATSAPP
  WALK_IN
}

/// Whether Nomad helps under the member's cover, or as a special request:
/// someone not covered (or something outside cover) taken on free of charge
/// or at a set cost. Accepted by any case manager; recorded in the timeline.
enum CaseCoverage {
  COVERED
  SPECIAL_FREE
  SPECIAL_PAID
}

/// A member's request for help. requestedBy is who asked (signed in);
/// patient is who the help is for — the same member, or someone in their
/// household. Step 1.3 adds the timeline, assignment and provider options.
model CareCase {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Short human-facing ID, shown as CAS-000123 (see lib/caseNumber.ts).
  caseNumber      Int             @unique @default(autoincrement()) @map("case_number")
  requestedById   String          @map("requested_by_id") @db.Uuid
  requestedBy     Member          @relation("CasesRequested", fields: [requestedById], references: [id])
  patientId       String          @map("patient_id") @db.Uuid
  patient         Member          @relation("CasesAbout", fields: [patientId], references: [id])
  categoryId      String          @map("category_id") @db.Uuid
  category        CaseCategoryRef @relation(fields: [categoryId], references: [id])
  /// The member's own words, unedited.
  description     String
  /// Where the case manager can call the member back, confirmed on the
  /// request form (pre-filled from the member's record). International
  /// format, e.g. "+221 77 123 45 67".
  contactPhone    String          @map("contact_phone")
  /// The member said this number has WhatsApp, so the case manager can
  /// message as well as call.
  contactHasWhatsapp Boolean      @default(false) @map("contact_has_whatsapp")
  urgency         CaseUrgency
  locationLabel   String?         @map("location_label")
  latitude        Float?
  longitude       Float?
  status          CaseStatus      @default(NEW)
  rag             CaseRag
  ragReasons      String[]        @map("rag_reasons")
  /// Set when staff overrode the colour by hand (with a reason, in the
  /// timeline). Automatic escalation still moves an overdue case up.
  ragOverridden   Boolean         @default(false) @map("rag_overridden")
  /// When staff must next respond: set from the colour's response time
  /// (case_response_target) when the case arrives or the member replies,
  /// cleared when staff respond. Past due = overdue → escalates a colour.
  responseDueAt   DateTime?       @map("response_due_at")
  assignedToId    String?         @map("assigned_to_id") @db.Uuid
  assignedTo      User?           @relation("CasesAssigned", fields: [assignedToId], references: [id])
  /// Last time the member opened this request in the app — messages from
  /// Nomad after this show as unread.
  memberLastSeenAt DateTime?      @map("member_last_seen_at")
  resolvedAt      DateTime?       @map("resolved_at")
  events          CaseEvent[]
  providerOptions CaseProviderOption[]
  actions         CaseAction[]
  notifications   StaffNotification[]
  providerTags    CaseProviderTag[]
  medicationOrder MedicationOrder?
  channel         CaseChannel     @default(MEMBER_APP)
  coverage        CaseCoverage    @default(COVERED)
  /// When the member got in touch — the response timer starts here. Same as
  /// createdAt for app requests; staff can log an earlier call or email.
  contactedAt     DateTime        @default(now()) @map("contacted_at")
  /// Whether the member sees this case (and staff messages) in the app. App
  /// requests always do; staff-created cases start hidden.
  visibleToMember Boolean         @default(true) @map("visible_to_member")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([rag, status])
  @@index([assignedToId])
  @@index([requestedById])
  @@index([patientId])
  @@map("care_case")
}

/// What members can ask for help with — Admin > Value lists.
model CaseCategoryRef {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String     @unique
  nameEn    String     @map("name_en")
  nameFr    String?    @map("name_fr")
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  cases CareCase[]

  @@map("case_category_ref")
}

enum EmergencyContactKind {
  /// Public emergency services (ambulance, police, fire).
  PUBLIC
  /// Nomad's own line.
  NOMAD
  /// Private ambulance / emergency doctor services open 24/7 (e.g. SOS
  /// Médecins, Urgences et Solutions Médicales).
  PRIVATE_EMS
}

/// Phone numbers the member app always shows. A contact with a country is
/// shown to members in that country; one without (e.g. the Nomad line) is
/// shown to everyone. Admin > Value lists.
model EmergencyContactRef {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String               @unique
  labelEn   String               @map("label_en")
  labelFr   String?              @map("label_fr")
  phone     String
  kind      EmergencyContactKind @default(PUBLIC)
  countryId String?              @map("country_id") @db.Uuid
  country   CountryRef?          @relation(fields: [countryId], references: [id])
  sortOrder Int                  @default(0) @map("sort_order")
  isActive  Boolean              @default(true) @map("is_active")
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@map("emergency_contact_ref")
}

enum CaseEventType {
  CREATED
  COLOUR_SET
  COLOUR_OVERRIDDEN
  ESCALATED
  ASSIGNED
  STATUS_CHANGED
  NOTE
  MESSAGE_TO_MEMBER
  MESSAGE_FROM_MEMBER
  PROVIDERS_FOUND
  PROVIDER_SELECTED
  ACTION_ADDED
  ACTION_DONE
  ACTION_REOPENED
  ACTIONS_CLOSED_WITH_CASE
  COVERAGE_CHANGED
  VISIBILITY_CHANGED
  PROVIDER_TAGGED
  PROVIDER_UNTAGGED
  QUOTE_SENT
  QUOTE_ANSWERED
  QUOTE_CHOSEN
  ORDER_STATUS_CHANGED
  PRICE_SENT
  PRICE_APPROVED
  PRICE_DECLINED
  PAYMENT_REPORTED
  PAYMENT_CONFIRMED
  PHARMACY_PAID
}

enum CaseActorType {
  MEMBER
  STAFF
  SYSTEM
}

/// The case timeline (MVP step 1.3): everything that happened, in order,
/// with who did it — which also makes it the case's audit trail, including
/// for member actions (the audit_log table only records staff). Messages to
/// and from the member live here too; visibleToMember marks what the member
/// app shows (internal notes never are).
model CaseEvent {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId          String        @map("case_id") @db.Uuid
  case            CareCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type            CaseEventType
  actorType       CaseActorType @map("actor_type")
  staffId         String?       @map("staff_id") @db.Uuid
  staff           User?         @relation("CaseEventsByStaff", fields: [staffId], references: [id])
  memberId        String?       @map("member_id") @db.Uuid
  member          Member?       @relation("CaseEventsByMember", fields: [memberId], references: [id])
  /// Free text: a note, a message, or the reason for an override.
  body            String?
  /// Small structured details, e.g. {"from":"NEW","to":"IN_PROGRESS"}.
  data            Json?
  visibleToMember Boolean       @default(false) @map("visible_to_member")
  mentions        CaseMention[]
  notifications   StaffNotification[]
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([caseId, createdAt])
  @@map("case_event")
}

enum CaseProviderSource {
  SEARCH
  STAFF
}

/// Providers suggested for a case: found by the existing provider search
/// near the member (active providers only, so never DO NOT USE), nearest
/// first. Staff mark the one they chose. Step 1.4's copilot adds ranking.
model CaseProviderOption {
  caseId     String             @map("case_id") @db.Uuid
  case       CareCase           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  providerId String             @map("provider_id") @db.Uuid
  provider   Provider           @relation(fields: [providerId], references: [id])
  rank       Int
  distanceKm Float?             @map("distance_km")
  source     CaseProviderSource @default(SEARCH)
  selected   Boolean            @default(false)
  createdAt  DateTime           @default(now()) @map("created_at")

  @@id([caseId, providerId])
  @@map("case_provider_option")
}

/// How quickly staff must respond to a case of each colour — one fixed row
/// per colour (code RED / YELLOW / GREEN), editable in Admin > Value lists.
/// businessHoursOnly counts only office hours (Mon–Fri 09:00–17:00 Dakar,
/// see lib/businessHours.ts); otherwise the clock runs 24/7 (on-call).
model CaseResponseTarget {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String   @unique
  labelEn           String   @map("label_en")
  labelFr           String?  @map("label_fr")
  minutes           Int
  businessHoursOnly Boolean  @default(true) @map("business_hours_only")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("case_response_target")
}

/// Templates for staff's internal notes on a case (Admin > Value lists >
/// Note templates): e.g. "Phone conversation with member", "Communication
/// to provider". Picking one fills the note box with its headers ("## …")
/// and bullet points ("- …") in the staff screen's language; the saved note
/// records which template it came from (case_event.data.noteType).
model CaseNoteTemplateRef {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  nameEn    String   @map("name_en")
  nameFr    String?  @map("name_fr")
  bodyEn    String?  @map("body_en")
  bodyFr    String?  @map("body_fr")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("case_note_template_ref")
}

/// A next action on a case: what needs doing, by whom, by when. Staff only —
/// never shown to the member. Due/overdue is worked out from dueAt when a
/// page loads (no reminder job). Closing a case can close its open actions
/// too (closedWithCase), after asking.
model CaseAction {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId         String    @map("case_id") @db.Uuid
  case           CareCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title          String
  ownerId        String    @map("owner_id") @db.Uuid
  owner          User      @relation("CaseActionOwner", fields: [ownerId], references: [id])
  dueAt          DateTime  @map("due_at")
  createdById    String    @map("created_by_id") @db.Uuid
  createdBy      User      @relation("CaseActionCreatedBy", fields: [createdById], references: [id])
  completedAt    DateTime? @map("completed_at")
  completedById  String?   @map("completed_by_id") @db.Uuid
  completedBy    User?     @relation("CaseActionCompletedBy", fields: [completedById], references: [id])
  closedWithCase Boolean   @default(false) @map("closed_with_case")
  createdAt      DateTime  @default(now()) @map("created_at")

  notifications StaffNotification[]

  @@index([ownerId, completedAt, dueAt])
  @@index([caseId, completedAt])
  @@map("case_action")
}

/// A staff member @mentioned in an internal note. Linked to the person, so a
/// later handle change still points at them; `handle` is what was typed, so
/// the note's text can be matched up with its mentions.
model CaseMention {
  eventId   String    @map("event_id") @db.Uuid
  event     CaseEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  handle    String
  createdAt DateTime  @default(now()) @map("created_at")

  @@id([eventId, userId])
  @@index([userId, createdAt])
  @@map("case_mention")
}

/// The header bell's "new" items: someone mentioned you, or gave you an
/// action. (Actions that are due come straight from case_action.)
model StaffNotification {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  user      User                  @relation("NotificationFor", fields: [userId], references: [id])
  kind      StaffNotificationKind
  caseId    String                @map("case_id") @db.Uuid
  case      CareCase              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  eventId   String?               @map("event_id") @db.Uuid
  event     CaseEvent?            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actionId  String?               @map("action_id") @db.Uuid
  action    CaseAction?           @relation(fields: [actionId], references: [id], onDelete: Cascade)
  actorId   String?               @map("actor_id") @db.Uuid
  actor     User?                 @relation("NotificationBy", fields: [actorId], references: [id])
  createdAt DateTime              @default(now()) @map("created_at")
  readAt    DateTime?             @map("read_at")

  @@index([userId, readAt, createdAt])
  @@map("staff_notification")
}

enum StaffNotificationKind {
  MENTION
  ACTION_ASSIGNED
  /// A medication order needs staff: the member approved, declined or says
  /// they've paid. `eventId` points at the timeline entry.
  ORDER_UPDATE
}

/// A provider (facility) the member is actively using, tagged to the case by
/// staff — found with Provider search or typed by ID (NMD-…). Unlike the
/// "Find providers" shortlist, any provider can be tagged, DO NOT USE
/// included (shown flagged). Removing a tag deletes the row; the timeline
/// keeps the history.
model CaseProviderTag {
  caseId      String   @map("case_id") @db.Uuid
  case        CareCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  providerId  String   @map("provider_id") @db.Uuid
  provider    Provider @relation(fields: [providerId], references: [id])
  taggedById  String   @map("tagged_by_id") @db.Uuid
  taggedBy    User     @relation(fields: [taggedById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@id([caseId, providerId])
  @@index([providerId])
  @@map("case_provider_tag")
}
