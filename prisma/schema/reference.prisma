/// What each star rating means, shown as hover text on the profile page's
/// Quality / Access ratings. One row per rating (codes QUALITY and ACCESS —
/// fixed, only their text is editable from Admin > Value lists): a general
/// description of the rating plus what each 1-5 star level means.
model RatingCriterionRef {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String   @unique
  name            String
  descriptionEn   String?  @map("description_en")
  descriptionFr   String?  @map("description_fr")
  level1MeaningEn String?  @map("level_1_meaning_en")
  level1MeaningFr String?  @map("level_1_meaning_fr")
  level2MeaningEn String?  @map("level_2_meaning_en")
  level2MeaningFr String?  @map("level_2_meaning_fr")
  level3MeaningEn String?  @map("level_3_meaning_en")
  level3MeaningFr String?  @map("level_3_meaning_fr")
  level4MeaningEn String?  @map("level_4_meaning_en")
  level4MeaningFr String?  @map("level_4_meaning_fr")
  level5MeaningEn String?  @map("level_5_meaning_en")
  level5MeaningFr String?  @map("level_5_meaning_fr")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("rating_criterion_ref")
}

