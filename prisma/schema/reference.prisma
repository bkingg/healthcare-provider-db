// Enum vs. reference-table rule (applied consistently across this schema):
// Use a Postgres ENUM when the value set is small, fixed, and application code itself
// branches on the specific value (activation gating, approval pipelines, import stages)
// — changing the set requires a code change anyway, so a migration is an acceptable cost.
// Use a REFERENCE TABLE when the values are business taxonomy/config that a Data Steward
// or Admin should be able to add to, retire, or reorder without a deploy.

/// How a payment type is settled — decides which fields the banking form asks
/// for (bank account details vs. a mobile money wallet number and merchant code).
enum PaymentCategory {
  BANK
  MOBILE_MONEY
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
  PENDING_REVIEW
  SUSPENDED
  CLOSED
  DO_NOT_USE
}

enum OperatingStatus {
  OPERATING
  TEMPORARILY_CLOSED
  PERMANENTLY_CLOSED
  UNKNOWN
}

enum CoordinateStatus {
  MISSING
  DEFAULT
  UNCONFIRMED
  CONFIRMED
}

enum ProviderNameType {
  LEGAL
  DISPLAY
  BILLING
  LOCAL
  ALIAS
}

/// Whether a provider is an organization/facility or a named individual —
/// set once at creation and drives which name fields (facility name vs.
/// title/first/last) apply to every ProviderName row on that provider.
enum ProviderNameKind {
  ENTITY
  INDIVIDUAL
}

/// Declared Monday-first so `ORDER BY day_of_week` (Postgres enums sort by
/// declaration order) lists a week the way staff actually read a posted
/// schedule, without the query needing a `CASE` expression to reorder it.
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ProviderTypeLevel {
  CATEGORY
  TYPE
  SUBTYPE
  SERVICE_GROUP
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContractStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  EXPIRED
  TERMINATED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
}

enum ImportBatchStatus {
  UPLOADED
  VALIDATING
  STAGED
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
  RECONCILED
  FAILED
}

enum DqSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum DqStatus {
  OPEN
  ASSIGNED
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum DqResolution {
  ACCEPT
  CORRECT
  REJECT
  MERGE
  IGNORE
}

enum NoteVisibility {
  PUBLIC
  INTERNAL
  RESTRICTED
}

/// Staging-row lifecycle for the Phase 4 import pipeline — fixed workflow
/// states the validate/commit code branches on directly.
enum StagingValidationStatus {
  PENDING
  VALIDATED
  REJECTED
  COMMITTED
}

model RegionRef {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  countries CountryRef[]

  @@map("region_ref")
}

model CountryRef {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  iso2            String          @unique @db.Char(2)
  regionId        String?         @map("region_id") @db.Uuid
  region          RegionRef?      @relation(fields: [regionId], references: [id])
  qualityRatingId String?         @map("quality_rating_id") @db.Uuid
  qualityRating   RatingScaleRef? @relation(fields: [qualityRatingId], references: [id])
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  providers Provider[]
  addresses Address[]

  @@map("country_ref")
}

/// Self-referencing hierarchy: category -> type -> subtype -> service group,
// modeled as one configurable table per the brief ("Provider category, type,
// subtype, service grouping (configurable reference table)").
model ProviderTypeRef {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  level       ProviderTypeLevel
  parentId    String?           @map("parent_id") @db.Uuid
  parent      ProviderTypeRef?  @relation("ProviderTypeHierarchy", fields: [parentId], references: [id])
  children    ProviderTypeRef[] @relation("ProviderTypeHierarchy")
  code        String            @unique
  nameEn      String            @map("name_en")
  nameFr      String?           @map("name_fr")
  description String?
  sortOrder   Int               @default(0) @map("sort_order")
  /// Map marker style, editable in Admin > Value lists > Provider types.
  /// Null means "use the built-in default for this type's code" (see
  /// src/lib/mapMarkerStyle.ts). mapIcon is one of MAP_ICON_KEYS; mapColor
  /// is a #rrggbb hex.
  mapIcon     String?           @map("map_icon")
  mapColor    String?           @map("map_color")
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  providerAssignments ProviderProviderType[]

  @@map("provider_type_ref")
}

