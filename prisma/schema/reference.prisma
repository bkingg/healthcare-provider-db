/// Curated catalog of Phase 4 validation rule codes, so `DataQualityException.rule`
// is a real FK instead of a free-text string that could drift across stewards.
model DqRuleRef {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String     @unique
  description     String
  defaultSeverity DqSeverity @map("default_severity")
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  exceptions DataQualityException[]

  @@map("dq_rule_ref")
}

