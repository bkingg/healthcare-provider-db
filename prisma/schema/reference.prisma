/// The healthcare-system rating scale: each country is assigned one value
/// (CountryRef.qualityRating), which the provider profile shows as the quality
/// of the healthcare environment in that provider's country. Managed from
/// Admin > Countries. (Distinct from the provider's own 1-5 Quality/Access
/// stars, whose hover text lives in RatingCriterionRef.)
model RatingScaleRef {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String   @unique
  label         String
  numericValue  Decimal? @map("numeric_value") @db.Decimal(4, 2)
  descriptionEn String?  @map("description_en")
  descriptionFr String?  @map("description_fr")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  countries CountryRef[]

  @@map("rating_scale_ref")
}

