# Copy to .env for local development (docker-compose.yml reads these too).

DATABASE_URL="postgresql://provider_admin:provider_dev_password@localhost:5432/healthcare_provider_db?schema=public"

POSTGRES_USER=provider_admin
POSTGRES_PASSWORD=provider_dev_password
POSTGRES_DB=healthcare_provider_db
POSTGRES_PORT=5432

# NextAuth v5 (Credentials provider, JWT sessions — see src/lib/auth.ts).
# Generate your own: `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-real-random-secret"
